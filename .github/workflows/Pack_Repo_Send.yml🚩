name: Pack_Repo_Send to Telegram

on:
  workflow_dispatch: # Sirf aapke manual click karne par chalega

jobs:
  bundle-and-send:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Zip Complete Repository
        run: |
          # Repository ki har ek file, photo, folder aur hidden file ko ZIP me pack karein
          zip -r full_repository_bundle.zip . -x ".git/*"

      - name: Send Bundle to Telegram
        env:
          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
        run: |
          if [ -z "$TELEGRAM_BOT_TOKEN" ] || [ -z "$TELEGRAM_CHAT_ID" ]; then
            echo "Error: TELEGRAM_BOT_TOKEN or TELEGRAM_CHAT_ID secret is missing!"
            exit 1
          fi

          curl -s -F chat_id="$TELEGRAM_CHAT_ID" \
               -F document=@full_repository_bundle.zip \
               -F caption="📦 Complete Repository Archive (All files, photos & folders)" \
               https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/sendDocument
