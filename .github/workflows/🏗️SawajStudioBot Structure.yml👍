name: "🏗️SawajStudioBot Structure"

on:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 30

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4
        with:
          token: ${{ secrets.TOKEN_GITHUB || secrets.GITHUB_TOKEN }}

      - name: Build Directory Structure & Move Files
        run: |
          set -e

          # 1. Workflows Directory
          mkdir -p .github/workflows
          touch .github/workflows/story_video_fb_ig.yml
          touch .github/workflows/short_video_fb_ig_yt.yml
          touch .github/workflows/long_video_fb_yt.yml

          # 2. Main Module
          mkdir -p sawajstudiobot
          touch sawajstudiobot/__init__.py

          # 3. video_requirement & assets
          mkdir -p sawajstudiobot/video_requirement/assets
          touch sawajstudiobot/video_requirement/__init__.py
          touch sawajstudiobot/video_requirement/requirements.txt
          touch sawajstudiobot/video_requirement/env.example
          touch sawajstudiobot/video_requirement/.gitignore
          touch sawajstudiobot/video_requirement/README.md
          touch sawajstudiobot/video_requirement/Makefile
          touch sawajstudiobot/video_requirement/pyproject.toml
          
          # Assets files
          touch sawajstudiobot/video_requirement/assets/.gitkeep
          touch sawajstudiobot/video_requirement/assets/watermark.png
          touch sawajstudiobot/video_requirement/assets/intro.png

          # MOVE LOGO.PNG FROM ROOT TO DESTINATION
          if [ -f "logo.png" ]; then
            mv logo.png sawajstudiobot/video_requirement/logo.png
            echo "Moved logo.png from root to video_requirement/"
          else
            touch sawajstudiobot/video_requirement/logo.png
            echo "logo.png not found in root, created a placeholder."
          fi

          # 4. video_uploader Structure
          mkdir -p sawajstudiobot/video_uploader/facebook
          mkdir -p sawajstudiobot/video_uploader/instagram
          mkdir -p sawajstudiobot/video_uploader/youtube

          touch sawajstudiobot/video_uploader/__init__.py
          touch sawajstudiobot/video_uploader/facebook/__init__.py
          touch sawajstudiobot/video_uploader/facebook/story_uploader.py
          touch sawajstudiobot/video_uploader/facebook/short_uploader.py
          touch sawajstudiobot/video_uploader/facebook/long_uploader.py

          touch sawajstudiobot/video_uploader/instagram/__init__.py
          touch sawajstudiobot/video_uploader/instagram/story_uploader.py
          touch sawajstudiobot/video_uploader/instagram/short_uploader.py

          touch sawajstudiobot/video_uploader/youtube/__init__.py
          touch sawajstudiobot/video_uploader/youtube/short_uploader.py
          touch sawajstudiobot/video_uploader/youtube/long_uploader.py

          # 5. video_generator Base
          mkdir -p sawajstudiobot/video_generator
          touch sawajstudiobot/video_generator/__init__.py

          # Function to build generator subfolders dynamically
          build_generator() {
            BASE="sawajstudiobot/video_generator/$1"
            TYPE="$2"

            mkdir -p "$BASE/A_core" "$BASE/B_graphics" "$BASE/C_content"
            mkdir -p "$BASE/D_video" "$BASE/E_audio" "$BASE/F_drive"
            mkdir -p "$BASE/G_entry" "$BASE/H_tests"
            mkdir -p "$BASE/output/temp" "$BASE/output/final"

            touch "$BASE/__init__.py"
            
            touch "$BASE/A_core/__init__.py"
            for f in A1_config A2_logger A3_telegram A4_utils A5_base_pipeline; do touch "$BASE/A_core/$f.py"; done

            touch "$BASE/B_graphics/__init__.py"
            for f in B1_fonts B2_text_wrap B3_sparkles B4_progress_bar B5_badge B6_bullets B7_watermark B8_arabesque B9_god_rays B10_star_field B11_ember B12_vignette; do touch "$BASE/B_graphics/$f.py"; done

            touch "$BASE/C_content/__init__.py"
            for f in C1_hadith C2_ai_provider C3_translator C4_tts C5_music C6_background C7_logo_processor C8_thumbnail; do touch "$BASE/C_content/$f.py"; done

            touch "$BASE/D_video/__init__.py"
            for f in D1_intro D2_main_content D3_outro D4_frames D5_transition D6_composer; do touch "$BASE/D_video/$f.py"; done

            touch "$BASE/E_audio/__init__.py"
            for f in E1_voice_ducking E2_sfx E3_mastering; do touch "$BASE/E_audio/$f.py"; done

            touch "$BASE/F_drive/__init__.py"
            touch "$BASE/F_drive/F1_drive.py"

            touch "$BASE/G_entry/__init__.py"
            touch "$BASE/G_entry/G1_${TYPE}_pipeline.py"
            touch "$BASE/G_entry/G2_run.py"

            touch "$BASE/H_tests/__init__.py"
            touch "$BASE/H_tests/H1_conftest.py"
            touch "$BASE/H_tests/H2_test_${TYPE}.py"
            touch "$BASE/H_tests/H3_test_media.py"
            touch "$BASE/H_tests/H4_test_render.py"

            touch "$BASE/output/temp/.gitkeep"
            touch "$BASE/output/final/.gitkeep"
          }

          build_generator "fb_ig_story_video_generator" "story"
          build_generator "fb_ig_yt_short_video_generator" "short"
          build_generator "fb_yt_long_video_generator" "long"

      - name: Commit and Push Changes
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "github-actions[bot]@users.noreply.github.com"
          
          # git add -A ensures moved/deleted files (like root logo.png) are tracked properly
          git add -A
          git status
          git commit -m "Build complete sawajstudiobot structure and move logo.png" || echo "No changes to commit"
          git push origin main || git push
